FROM golang:1.26.4-bookworm AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN GOMAXPROCS=1 CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/anonbird-signal ./signal

FROM gcr.io/distroless/base-debian12:nonroot
ENTRYPOINT ["/usr/local/bin/anonbird-signal", "run"]
CMD ["--log-file", "console", "--port", "10000"]
COPY --from=builder /out/anonbird-signal /usr/local/bin/anonbird-signal
