x-default: &default
  restart: 'unless-stopped'
  logging:
    driver: 'json-file'
    options:
      max-size: '500m'
      max-file: '2'

services:
  # UI dashboard
  dashboard:
    <<: *default
    image: $ANONBIRD_DASHBOARD_IMAGE:$NETBIRD_DASHBOARD_TAG
    environment:
      # Endpoints
      - NETBIRD_MGMT_API_ENDPOINT=$NETBIRD_MGMT_API_ENDPOINT
      - NETBIRD_MGMT_GRPC_API_ENDPOINT=$NETBIRD_MGMT_API_ENDPOINT
      # OIDC
      - AUTH_AUDIENCE=$NETBIRD_DASH_AUTH_AUDIENCE
      - AUTH_CLIENT_ID=$NETBIRD_AUTH_CLIENT_ID
      - AUTH_CLIENT_SECRET=$NETBIRD_AUTH_CLIENT_SECRET
      - AUTH_AUTHORITY=$NETBIRD_AUTH_AUTHORITY
      - USE_AUTH0=$NETBIRD_USE_AUTH0
      - AUTH_SUPPORTED_SCOPES=$NETBIRD_AUTH_SUPPORTED_SCOPES
      - AUTH_REDIRECT_URI=$NETBIRD_AUTH_REDIRECT_URI
      - AUTH_SILENT_REDIRECT_URI=$NETBIRD_AUTH_SILENT_REDIRECT_URI
      - NETBIRD_TOKEN_SOURCE=$NETBIRD_TOKEN_SOURCE
      # SSL
      - NGINX_SSL_PORT=443
      # Letsencrypt
      - LETSENCRYPT_DOMAIN=$NETBIRD_LETSENCRYPT_DOMAIN
      - LETSENCRYPT_EMAIL=$NETBIRD_LETSENCRYPT_EMAIL
    volumes:
      - $LETSENCRYPT_VOLUMENAME:/etc/letsencrypt/
    labels:
    - traefik.enable=true
    - traefik.http.routers.anonbird-dashboard.rule=Host(`$NETBIRD_DOMAIN`)
    - traefik.http.services.anonbird-dashboard.loadbalancer.server.port=80

  # Signal
  signal:
    <<: *default
    image: $ANONBIRD_SIGNAL_IMAGE:$NETBIRD_SIGNAL_TAG
    volumes:
      - $SIGNAL_VOLUMENAME:/var/lib/anonbird
    labels:
    - traefik.enable=true
    - traefik.http.routers.anonbird-wsproxy-signal.rule=Host(`$NETBIRD_DOMAIN`) && PathPrefix(`/ws-proxy/signal`)
    - traefik.http.routers.anonbird-wsproxy-signal.service=anonbird-wsproxy-signal
    - traefik.http.services.anonbird-wsproxy-signal.loadbalancer.server.port=80
    - traefik.http.routers.anonbird-signal.rule=Host(`$NETBIRD_DOMAIN`) && PathPrefix(`/signalexchange.SignalExchange/`)
    - traefik.http.routers.anonbird-signal.service=anonbird-signal
    - traefik.http.services.anonbird-signal.loadbalancer.server.port=10000
    - traefik.http.services.anonbird-signal.loadbalancer.server.scheme=h2c

  # Relay
  relay:
    <<: *default
    image: $ANONBIRD_RELAY_IMAGE:$NETBIRD_RELAY_TAG
    environment:
    - NB_LOG_LEVEL=info
    - NB_LISTEN_ADDRESS=:33080
    - NB_EXPOSED_ADDRESS=$NETBIRD_RELAY_ENDPOINT
    # todo: change to a secure secret
    - NB_AUTH_SECRET=$NETBIRD_RELAY_AUTH_SECRET
    labels:
    - traefik.enable=true
    - traefik.http.routers.anonbird-relay.rule=Host(`$NETBIRD_DOMAIN`) && PathPrefix(`/relay`)
    - traefik.http.services.anonbird-relay.loadbalancer.server.port=33080

  # Management
  management:
    <<: *default
    image: $ANONBIRD_MANAGEMENT_IMAGE:$NETBIRD_MANAGEMENT_TAG
    depends_on:
      - dashboard
    volumes:
      - $MGMT_VOLUMENAME:/var/lib/anonbird
      - $LETSENCRYPT_VOLUMENAME:/etc/letsencrypt:ro
      - ./management.json:/etc/anonbird/management.json
    command: [
      "--config", "/etc/anonbird/management.json",
      "--port", "33073",
      "--log-file", "console",
      "--log-level", "info",
      "--disable-anonymous-metrics=$NETBIRD_DISABLE_ANONYMOUS_METRICS",
      "--single-account-mode-domain=$NETBIRD_MGMT_SINGLE_ACCOUNT_MODE_DOMAIN",
      "--dns-domain=$NETBIRD_MGMT_DNS_DOMAIN"
      ]
    labels:
    - traefik.enable=true
    - traefik.http.routers.anonbird-api.rule=Host(`$NETBIRD_DOMAIN`) && PathPrefix(`/api`)
    - traefik.http.routers.anonbird-api.service=anonbird-api
    - traefik.http.services.anonbird-api.loadbalancer.server.port=33073
    - traefik.http.routers.anonbird-wsproxy-mgmt.rule=Host(`$NETBIRD_DOMAIN`) && PathPrefix(`/ws-proxy/management`)
    - traefik.http.routers.anonbird-wsproxy-mgmt.service=anonbird-wsproxy-mgmt
    - traefik.http.services.anonbird-wsproxy-mgmt.loadbalancer.server.port=33073
    - traefik.http.routers.anonbird-management.rule=Host(`$NETBIRD_DOMAIN`) && PathPrefix(`/management.ManagementService/`)
    - traefik.http.routers.anonbird-management.service=anonbird-management
    - traefik.http.services.anonbird-management.loadbalancer.server.port=33073
    - traefik.http.services.anonbird-management.loadbalancer.server.scheme=h2c
    environment:
      - NB_DISABLE_GEOLOCATION=true
      - NETBIRD_STORE_ENGINE_POSTGRES_DSN=$NETBIRD_STORE_ENGINE_POSTGRES_DSN
      - NETBIRD_STORE_ENGINE_MYSQL_DSN=$NETBIRD_STORE_ENGINE_MYSQL_DSN
      
  # Coturn
  coturn:
    <<: *default
    image: coturn/coturn:$COTURN_TAG
    domainname: $TURN_DOMAIN
    volumes:
      - ./turnserver.conf:/etc/turnserver.conf:ro
    network_mode: host
    command:
      - -c /etc/turnserver.conf

volumes:
  $MGMT_VOLUMENAME:
  $SIGNAL_VOLUMENAME:
  $LETSENCRYPT_VOLUMENAME:
