FROM golang:1.25-bookworm AS builder
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y gcc libc6-dev git && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build with version info from CI/deploy args. Fallbacks keep local docker builds useful.
ARG ANONBIRD_VERSION
ARG ANONBIRD_COMMIT
ARG ANONBIRD_DATE
RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w \
    -X github.com/netbirdio/netbird/version.version=${ANONBIRD_VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo 'development')} \
    -X main.commit=${ANONBIRD_COMMIT:-$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown')} \
    -X main.date=${ANONBIRD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)} \
    -X main.builtBy=docker" \
    -o anonbird-server ./combined

FROM ubuntu:24.04
RUN apt update && apt install -y ca-certificates && rm -fr /var/cache/apt
ENTRYPOINT [ "/go/bin/anonbird-server" ]
CMD ["--config", "/etc/anonbird/config.yaml"]
COPY --from=builder /app/anonbird-server /go/bin/anonbird-server
